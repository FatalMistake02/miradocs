{
  "name": "miradocs",
  "version": "1.0.0",
  "type": "module",
  "description": "A customizable static documentation framework.",
  "bin": {
    "miradocs": "./bin/miradocs.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "assets",
    "miradocs.schema.json"
  ],
  "scripts": {
    "build": "node bin/miradocs.js build",
    "dev": "node bin/miradocs.js dev",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-static": "^1.75.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "simple-icons": "^16.38.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FatalMistake02/miradocs.git"
  }
