{
  "name": "miradocs",
  "version": "1.0.2",
  "type": "module",
  "description": "A customizable static documentation framework.",
  "bin": {
    "miradocs": "./bin/miradocs.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "assets",
    "miradocs.schema.json"
  ],
  "scripts": {
    "build": "node bin/miradocs.js build",
    "dev": "node bin/miradocs.js dev",
    "test": "node --test",
    "check": "npm test && npm run build",
    "pretest": "node packages/create-miradocs/build.js",
    "pack:creator": "npm pack ./packages/create-miradocs",
    "test:install": "node scripts/check-install.js",
    "release:publish": "node scripts/publish-release.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-static": "^1.75.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "proper-lockfile": "^4.1.2",
    "simple-icons": "^16.38.0",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FatalMistake02/miradocs.git"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.45",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.58.0",
    "vue": "^3.5.45"
  }
}
